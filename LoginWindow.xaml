<Window x:Class="Hub.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="hub.png"
        FontFamily="Segoe UI"
        Background="White">

    <Window.Resources>
        <Style x:Key="LinkStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Cursor"           Value="Hand" />
            <Setter Property="Padding"          Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="28,24,28,24">

        <!-- Titre -->
        <TextBlock x:Name="AppTitleText"
                   FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,18" />

        <!-- ══ VUE 1 : Sélection ══ -->
        <StackPanel x:Name="SelectView">

            <TextBlock x:Name="SelectUserLabel" FontSize="12" Margin="0,0,0,4" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="UserComboBox"
                          Grid.Column="0"
                          Height="30" Padding="8,0"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Left"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="UserComboBox_SelectionChanged" />
                <Button x:Name="RemoveUserButton"
                        Grid.Column="1"
                        Width="28" Height="28" Margin="6,0,0,0"
                        ToolTip="Supprimer"
                        Visibility="Collapsed"
                        Click="RemoveSelectedUser_Click">✕</Button>
            </Grid>

            <Button x:Name="SelectConnectButton"
                    Height="30"
                    Margin="0,0,0,12"
                    IsEnabled="False"
                    Click="SelectConnect_Click" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Button x:Name="NewAccountButton"
                        Style="{StaticResource LinkStyle}"
                        Click="NewAccount_Click">
                    <TextBlock x:Name="OtherAccountText"
                               Foreground="#0067C0" FontSize="12"
                               TextDecorations="Underline" />
                </Button>
                <TextBlock x:Name="SepText" Text=" · "
                           Foreground="#888" FontSize="12"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
                <Button x:Name="FirstConnectionLink"
                        Style="{StaticResource LinkStyle}"
                        Visibility="Collapsed"
                        Click="FirstConnection_Click">
                    <TextBlock x:Name="FirstConnectionText"
                               Foreground="#0067C0" FontSize="12"
                               TextDecorations="Underline" />
                </Button>
            </StackPanel>

            <Button x:Name="QuitButton"
                    HorizontalAlignment="Right"
                    Width="100" Height="28"
                    Click="CancelButton_Click" />
        </StackPanel>

        <!-- ══ VUE 2 : Mot de passe ══ -->
        <StackPanel x:Name="PasswordView" Visibility="Collapsed">

            <TextBlock x:Name="SelectedDisplayName"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,12" />

            <TextBlock x:Name="PasswordLabel" FontSize="12" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordBox" Height="28" Padding="6,4" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#C62828" FontSize="11"
                       Margin="0,6,0,0" Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BackButton"
                        Width="90" Height="28" Margin="0,0,6,0"
                        Click="BackToSelect_Click" />
                <Button x:Name="LoginButton"
                        Width="120" Height="28"
                        IsDefault="True"
                        Click="LoginButton_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ══ VUE 3 : Nouveau compte ══ -->
        <StackPanel x:Name="NewAccountView" Visibility="Collapsed">

            <TextBlock x:Name="UsernameLabel" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="UserNameTextBox" Height="28" Padding="6,4" Margin="0,0,0,12" />

            <TextBlock x:Name="NewPasswordLabel" FontSize="12" Margin="0,0,0,4" />
            <PasswordBox x:Name="NewPasswordBox" Height="28" Padding="6,4" />

            <TextBlock x:Name="NewErrorText"
                       Foreground="#C62828" FontSize="11"
                       Margin="0,6,0,0" Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BackFromNewButton"
                        Width="90" Height="28" Margin="0,0,6,0"
                        Click="BackToSelect_Click" />
                <Button x:Name="NewLoginButton"
                        Width="120" Height="28"
                        IsDefault="True"
                        Click="NewLoginButton_Click" />
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
