<Window x:Class="Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hub"
        Height="800" Width="1280"
        MinHeight="500" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="hub.png"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#F3F3F3">

    <Window.Resources>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width"            Value="34" />
            <Setter Property="Height"           Value="30" />
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Foreground"       Value="#1A1A1A" />
            <Setter Property="Cursor"           Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B8BCC4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background"       Value="#E01B0D" />
            <Setter Property="Foreground"       Value="White" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Padding"          Value="14,0" />
            <Setter Property="Height"           Value="28" />
            <Setter Property="FontSize"         Value="12" />
            <Setter Property="FontWeight"       Value="SemiBold" />
            <Setter Property="Cursor"           Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C41508" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#A01006" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddTabButtonStyle" TargetType="Button">
            <Setter Property="Width"            Value="28" />
            <Setter Property="Height"           Value="28" />
            <Setter Property="Background"       Value="Transparent" />
            <Setter Property="BorderThickness"  Value="0" />
            <Setter Property="Foreground"       Value="#5A6470" />
            <Setter Property="FontSize"         Value="18" />
            <Setter Property="Cursor"           Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F000000" />
                                <Setter Property="Foreground" Value="#0067C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="44" />
            <RowDefinition Height="2"  />
            <RowDefinition Height="*"  />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#ECEEF2"
                BorderBrush="#E4E7EC" BorderThickness="0,0,0,1"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="TabsScroller"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Focusable="False"
                              PreviewMouseWheel="TabsScroller_PreviewMouseWheel">
                    <StackPanel x:Name="TabsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Stretch" />
                </ScrollViewer>

                <Button Grid.Column="1"
                        x:Name="AddTabButton"
                        Style="{StaticResource AddTabButtonStyle}"
                        Margin="4,0,6,0"
                        VerticalAlignment="Center"
                        ToolTip="Nouvel onglet"
                        Click="AddTab_Click">+</Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White"
                BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Back_Click" IsEnabled="False">
                    <TextBlock Text="&#x2190;" FontSize="15" />
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="1"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Forward_Click" IsEnabled="False">
                    <TextBlock Text="&#x2192;" FontSize="15" />
                </Button>
                <Button x:Name="RefreshButton" Grid.Column="2"
                        Style="{StaticResource NavButtonStyle}"
                        Click="Refresh_Click">
                    <TextBlock x:Name="RefreshIcon" Text="&#x21BB;" FontSize="15" />
                </Button>
                <Button x:Name="HomeButton" Grid.Column="3"
                        Style="{StaticResource NavButtonStyle}"
                        ToolTip="Accueil"
                        Click="Home_Click" Margin="0,0,6,0">
                    <Path Width="16" Height="16"
                          Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 12,3 L 22,12 L 19,12 L 19,21 L 14,21 L 14,14 L 10,14 L 10,21 L 5,21 L 5,12 L 2,12 Z" />
                </Button>

                <Border x:Name="AddressBarBorder"
                        Grid.Column="4"
                        Background="#F3F5F8"
                        CornerRadius="14"
                        BorderBrush="#DDE2E8"
                        BorderThickness="1"
                        Margin="0,7,8,7"
                        Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LockIcon"
                                   Grid.Column="0"
                                   Text="&#x1F512;" FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="#2EA043" />
                        <TextBox x:Name="AddressBar"
                                 Grid.Column="1"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 Foreground="#1A1A1A"
                                 Background="Transparent"
                                 CaretBrush="#0067C0"
                                 KeyDown="AddressBar_KeyDown"
                                 GotFocus="AddressBar_GotFocus"
                                 LostFocus="AddressBar_LostFocus" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="5" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="2,0,4,0">
                    <Border Width="26" Height="26" CornerRadius="13"
                            Background="#0067C0" Margin="0,0,8,0">
                        <TextBlock x:Name="UserAvatarInitials"
                                   Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="UserInfoText"
                               Foreground="#1A1A1A"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <Button x:Name="LogoutButton"
                            Style="{StaticResource LogoutButtonStyle}"
                            Click="Logout_Click">
                        <TextBlock x:Name="LogoutText" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="2"
                     IsIndeterminate="True"
                     Visibility="Collapsed"
                     Foreground="#0067C0"
                     Background="Transparent"
                     BorderThickness="0" />

        <ContentControl x:Name="BrowserHost" Grid.Row="3" />

    </Grid>
</Window>
